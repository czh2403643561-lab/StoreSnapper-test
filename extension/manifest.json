{
  "manifest_version": 3,
  "name": "StoreSnapper · 电商工作台",
  "version": "0.4.5",
  "description": "Temu 图片找货与 TikTok Shop 商品管理采集。",
  "icons": {
    "16": "assets/storesnapper-16.png",
    "32": "assets/storesnapper-32.png",
    "48": "assets/storesnapper-48.png",
    "128": "assets/storesnapper-128.png"
  },
  "action": {
    "default_title": "打开 StoreSnapper 工作台",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/storesnapper-16.png",
      "32": "assets/storesnapper-32.png"
    }
  },
  "permissions": ["cookies", "scripting", "tabs", "storage", "sidePanel"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' data: https://cbu01.alicdn.com;"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "host_permissions": [
    "https://www.temu.com/*",
    "https://img.kwcdn.com/*",
    "https://img-eu.kwcdn.com/*",
    "https://aimg.kwcdn.com/*",
    "https://cbu01.alicdn.com/*",
    "https://h5api.m.1688.com/*",
    "https://search.1688.com/*",
    "https://air.1688.com/*",
    "https://www.1688.com/*",
    "https://login.1688.com/*",
    "https://detail.1688.com/*",
    "https://seller.eu.tiktokshopglobalselling.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.temu.com/*"],
      "js": ["tiktok-core.js", "content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://seller.eu.tiktokshopglobalselling.com/*"],
      "js": ["tiktok-core.js", "tiktok-content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/storesnapper-16.png", "assets/storesnapper-32.png", "assets/storesnapper-48.png", "assets/storesnapper-128.png"],
      "matches": ["https://www.temu.com/*", "https://seller.eu.tiktokshopglobalselling.com/*"]
    }
  ]
}
